{
  "name": "captus",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "ingest": "tsx src/scripts/ingest-faq.ts",
    "onboard": "tsx src/scripts/onboard-tenant.ts",
    "link-user": "tsx src/scripts/link-user.ts",
    "status": "tsx src/scripts/status.ts"
  },
  "dependencies": {
    "@clerk/backend": "^1.18.0",
    "@fastify/cors": "^10.0.2",
    "bullmq": "^5.28.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
