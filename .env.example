# Server
PORT=3000

# Postgres (matches docker-compose.yml) — the superuser/owner connection,
# used ONLY for migrations/DDL (npm run migrate). The running app connects as
# a separate restricted role instead — see APP_DB_PASSWORD below — because
# Postgres superusers bypass Row Level Security entirely, which would make
# Stage 3's tenant isolation a no-op if the app used this connection.
DATABASE_URL=postgres://captus:captus@localhost:5432/captus
# Password for the restricted `captus_app` role that the app actually runs as
# (created by `npm run migrate`). Change from the dev default if this DB is
# ever reachable from outside your machine.
# APP_DB_PASSWORD=captus_app_dev

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Meta WhatsApp Cloud API — app-level config, shared by every tenant (one
# Meta app/webhook serves all of them, routed by phone_number_id).
WHATSAPP_ACCESS_TOKEN=
# Arbitrary string you choose yourself — enter the SAME value in the Meta dashboard webhook config
WHATSAPP_VERIFY_TOKEN=
# App Secret from Meta App Dashboard > App Settings > Basic — used to verify webhook signatures
WHATSAPP_APP_SECRET=

# Stage 3: this phone number id is ONLY used once, by `npm run migrate`, to
# seed your first tenant (using BUSINESS_NAME/BUSINESS_DESCRIPTION below) and
# backfill any pre-Stage-3 rows onto it. Every tenant after that — including
# this one, if you re-onboard it — is a row in the `tenants` table, created
# via `npm run onboard`, not an env var.
WHATSAPP_PHONE_NUMBER_ID=

# Gemini API key (Google AI Studio, free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional overrides, defaults shown — change only if a model name is deprecated/renamed
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite

# One-time default-tenant bootstrap only (see WHATSAPP_PHONE_NUMBER_ID above)
BUSINESS_NAME=
BUSINESS_DESCRIPTION=

# Stage 2: WhatsApp number (digits only, e.g. 6512345678) to ping when a conversation
# needs a human. Optional — if blank, escalations are only logged.
OWNER_NOTIFY_NUMBER=

# Stage 2 hardening — optional, defaults shown
# MESSAGE_DEBOUNCE_MS=7000
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_MESSAGES=10

# Stage 4: dashboard auth. Secret Key from your Clerk dashboard (API Keys page)
# — verifies session tokens sent by the Next.js dashboard app.
CLERK_SECRET_KEY=
# The dashboard app's own origin (CORS allowlist) — default is its local dev port.
# DASHBOARD_ORIGIN=http://localhost:3001

# Stage 5: booking. Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). Redirect URI must be registered there as
# exactly `${your backend's public URL}/api/google/callback`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32-byte key, base64 — encrypts stored Google refresh tokens at rest
# (lib/crypto.ts). Generate with: openssl rand -base64 32
# Rotating this strands every connected tenant's calendar — they'd reconnect.
TOKEN_ENCRYPTION_KEY=
